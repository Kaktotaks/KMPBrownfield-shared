-- Schema version 2 (1.sqm adds the time and place columns). Migrations live in migrations/N.sqm;
-- databases/N.db are the committed snapshots verifyMigrations checks them against.
-- Voice notes: only the file NAME is stored (relative to the voice-notes directory); the
-- absolute path changes between iOS installs.

CREATE TABLE TaskEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    notes TEXT NOT NULL,
    priority TEXT NOT NULL,            -- Priority.name
    due_date TEXT NOT NULL,            -- ISO yyyy-MM-dd (LocalDate.toString())
    is_done INTEGER NOT NULL DEFAULT 0,
    voice_file TEXT,                   -- file NAME only
    voice_duration_ms INTEGER,
    voice_waveform TEXT,               -- 40 comma-separated floats 0..1, 3 decimals
    due_time TEXT,                     -- ISO HH:mm, NULL = no time (schema v2)
    place_lat REAL,                    -- place_* are all NULL or all set (schema v2)
    place_lng REAL,
    place_address TEXT
);

CREATE TABLE Meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL                -- 'seeded' = '1'
);

selectAll:
SELECT * FROM TaskEntity ORDER BY id;

selectById:
SELECT * FROM TaskEntity WHERE id = ?;

insert:
INSERT INTO TaskEntity(id, title, notes, priority, due_date, is_done, voice_file, voice_duration_ms, voice_waveform, due_time, place_lat, place_lng, place_address)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Used by the first-launch seed: an id the user already took locally is kept (API row skipped).
insertOrIgnore:
INSERT OR IGNORE INTO TaskEntity(id, title, notes, priority, due_date, is_done, voice_file, voice_duration_ms, voice_waveform, due_time, place_lat, place_lng, place_address)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Voice columns are written only by setVoiceNote / clearVoiceNote, never by update.
-- Time and place are written by update (the task carries the full value).
update:
UPDATE TaskEntity SET title = ?, notes = ?, priority = ?, due_date = ?, due_time = ?, place_lat = ?, place_lng = ?, place_address = ?, is_done = ? WHERE id = ?;

setDone:
UPDATE TaskEntity SET is_done = ? WHERE id = ?;

delete:
DELETE FROM TaskEntity WHERE id = ?;

setVoiceNote:
UPDATE TaskEntity SET voice_file = ?, voice_duration_ms = ?, voice_waveform = ? WHERE id = ?;

clearVoiceNote:
UPDATE TaskEntity SET voice_file = NULL, voice_duration_ms = NULL, voice_waveform = NULL WHERE id = ?;

setPlace:
UPDATE TaskEntity SET place_lat = ?, place_lng = ?, place_address = ? WHERE id = ?;

clearPlace:
UPDATE TaskEntity SET place_lat = NULL, place_lng = NULL, place_address = NULL WHERE id = ?;

selectByDate:
SELECT * FROM TaskEntity WHERE due_date = ? ORDER BY id;

maxId:
SELECT COALESCE(MAX(id), 0) FROM TaskEntity;

voiceFileOf:
SELECT voice_file FROM TaskEntity WHERE id = ?;

allVoiceFiles:
SELECT voice_file FROM TaskEntity WHERE voice_file IS NOT NULL;

getMeta:
SELECT value FROM Meta WHERE key = ?;

setMeta:
INSERT OR REPLACE INTO Meta(key, value) VALUES (?, ?);
